<!doctype html>
<html lang="en">
{{> header }}
<body id="swap" hx-ext="response-targets" class="bg-gray-800 text-white">
    {{#if Authenticated }}
        <div class="mt-5 ml-2">
            {{> users }}
        </div>
    {{/if}}
    <div class="flex flex-col justify-center items-center p-4">
        <a
            href="https://github.com/ManeeshWije/watch-together"
            class="text-white hover:underline"
        >
            Source Code
        </a>
        {{#if Authenticated }}
            {{> logout }}
            {{> sidebar }}
            {{> video }}
        {{else}}
            {{> login }}
        {{/if}}
        {{> footer }}
    </div>
</body>
<script src="client/client.js"></script>
</html>
