<form id="video-form">
    <div class="mb-4 w-full p-4">
        <label for="video-url" class="block text-lg font-medium text-white">
            Add Youtube Video URL
        </label>
        <div class="flex items-center gap-2 mt-2">
            <input
                type="text"
                class="block w-full rounded-lg border-gray-300 shadow-md focus:border-indigo-500 focus:ring-indigo-500 text-lg"
                id="video-url"
                aria-describedby="video-url"
            />
            <button
                type="submit"
                class="bg-green-500 text-white font-medium py-2 px-4 rounded-lg hover:bg-green-600 text-lg"
            >
                Add
            </button>
        </div>
    </div>
    <div class="text-center">
        <div id="download-container" class="hidden mt-4">
            <p class="text-sm text-white">Downloading...</p>
        </div>
        <div id="progress-container" class="hidden mt-4">
            <label
                for="progress"
                class="block text-sm font-medium text-white"
            >
                Uploading...
            </label>
            <progress
                id="progress"
                value="0"
                max="100"
                class="w-full h-6 rounded border border-gray-300"
            ></progress>
        </div>
    </div>
</form>
