<div class="flex flex-col p-4 gap-5">
    {{> inputVideo }}
    {{#each objects}}
        <div class="flex items-center gap-4">
            <button
                onclick="sendVideoKey('{{this}}')"
                ontouchstart="sendVideoKey('{{this}}')"
                class="bg-blue-500 text-white font-bold flex-grow py-2 px-4 rounded hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2"
                id="video-list-{{this}}"
            >
                {{this}}
            </button>
            <button
                onclick="deleteObject('{{this}}')"
                class="bg-red-500 text-white py-2 px-4 rounded hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2"
                aria-label="Delete {{this}}"
            >
                X
            </button>
        </div>
    {{/each}}
</div>
