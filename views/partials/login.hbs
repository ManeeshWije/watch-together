<div
    id="login"
    class="d-flex flex-column justify-content-center align-items-center"
>
    <h1 class="text-white py-4 display-4 fw-bold">Watch Together</h1>
    <h3 class="text-white py-4 text-center">A simple way to watch videos in real
        time with multiple connected clients</h3>
    <form
        class="text-dark bg-light shadow rounded px-4 pt-4 pb-4 mb-4"
        id="password-form"
        hx-post="/submit"
        hx-swap="outerHTML"
        hx-target="#swap"
        hx-push-url="/videos"
    >
        <div class="mb-3">
            <label class="form-label fw-bold" for="password">
                Password
            </label>
            <input
                class="form-control"
                id="password"
                type="password"
                name="password"
                placeholder="******************"
            />
        </div>
        <button class="btn btn-primary btn-block fw-bold" type="submit">
            Enter
        </button>
    </form>
</div>
