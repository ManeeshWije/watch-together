{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.uuid, u.username, u.email, u.created_at, u.num_uploads, u.is_admin\n        FROM users AS u\n        LEFT JOIN user_sessions AS s ON u.uuid = s.user_uuid\n        WHERE s.uuid = $1 AND s.expires_at > $2\n        ",
